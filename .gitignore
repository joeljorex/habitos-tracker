# --- Android / Kotlin (app/) ---
app/*.iml
app/.gradle/
app/local.properties
app/.idea/
app/build/
app/captures/
app/.externalNativeBuild/
app/.cxx/
app/*.apk
app/*.aab

# --- Laravel / PHP (api/) ---
api/vendor/
api/node_modules/
api/.env
api/storage/*.key
api/storage/logs/*.log
api/bootstrap/cache/*.php
api/public/hot
api/public/storage
api/.phpunit.result.cache

# --- Panel web / Node (web/, tests/) ---
node_modules/
playwright-report/
test-results/
blob-report/
coverage/

# --- Terraform (infra/terraform/) ---
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log

# --- Agentes de IA (Spec Kit / Claude Code) ---
# Las skills (.claude/skills/) sí se versionan; la configuración local no.
.claude/settings.local.json

# --- Python (scripts de Spec Kit) ---
__pycache__/
*.pyc

# --- General ---
.DS_Store
*.log
.env
.env.local
